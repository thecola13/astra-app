{
  "name": "@astra/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, inferred types, constants and the typed API client shared across ASTRA apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types src/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astra/config": "*",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3"
  }
}
